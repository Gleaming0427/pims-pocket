{
  "expo": {
    "name": "Pims Pocket",
    "slug": "PocketKids",
    "version": "1.4.0",
    "platforms": ["ios", "android"],
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F5F9",
    "newArchEnabled": true,
    "scheme": "pimspocket",
    "ios": {
      "buildNumber": "5",
      "supportsTablet": true,
      "bundleIdentifier": "com.pimspocket.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "firebaseio.com": {
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSIncludesSubdomains": true
            },
            "googleapis.com": {
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSIncludesSubdomains": true
            },
            "firebaseapp.com": {
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSIncludesSubdomains": true
            },
            "firebasestorage.googleapis.com": {
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSIncludesSubdomains": true
            },
            "exp.host": {
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSIncludesSubdomains": true
            }
          }
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/adaptive-icon-background.png"
      },
      "package": "com.pimspocket.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "versionCode": 6
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "imageWidth": 192,
          "resizeMode": "contain",
          "backgroundColor": "#F3F5F9",
          "dark": {
            "image": "./assets/splash-mark.png",
            "backgroundColor": "#F3F5F9"
          }
        }
      ],
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-updates",
      "@sentry/react-native"
    ],
    "updates": {
      "url": "https://u.expo.dev/3e246b44-750f-44b7-88bd-226d6cafe564",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": "1.4.0",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3e246b44-750f-44b7-88bd-226d6cafe564"
      }
    },
    "owner": "voyage7981"
  }
}
