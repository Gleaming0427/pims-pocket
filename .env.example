EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_PROJECT_ID=your_expo_project_id
# Optional: skip Expo push entirely.
# EXPO_PUBLIC_SKIP_EXPO_PUSH_REGISTRATION=0
# In __DEV__, push registration is off unless ExpoDevice native is linked (simulator) or you set:
# EXPO_PUBLIC_ENABLE_PUSH_IN_DEV=1
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Si vous voyez auth/network-request-failed (doc: erreur réseau / hôte injoignable) :
# - Vérifiez la connexion Internet de l'appareil ou du simulateur.
# - Vérifiez apiKey, authDomain, projectId (Firebase Console > Paramètres du projet).
# - Si la clé API a des "Restrictions d'API" dans Google Cloud Console, incluez au minimum
#   Identity Toolkit API et Token Service API : https://firebase.google.com/docs/projects/api-keys
